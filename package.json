{
  "name": "@1pizzateam/spockjs",
  "version": "4.0.0",
  "description": "Mathematics library for Javascript",
  "keywords": [
    "maths",
    "geometry",
    "vector",
    "trigonometry",
    "matrices",
    "bezier curves",
    "lerp"
  ],
  "homepage": "https://github.com/1pizzateam/Spock.js",
  "type": "module",
  "sideEffects": false,
  "main": "dist/spock.js",
  "types": "dist/spock.d.ts",
  "exports": {
    ".": {
      "types": "./dist/spock.d.ts",
      "import": "./dist/spock.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1pizzateam/Spock.js.git"
  },
  "bugs": {
    "url": "https://github.com/1pizzateam/Spock.js/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber"
  },
  "contributors": [],
  "scripts": {
    "prebuild": "npm install",
    "build": "npm run build:lib && npm run test",
    "build:lib": "node ./scripts/clear.js && tsc && npm run rollup && node ./scripts/copy.js",
    "rollup": "rollup --config rollup.config.mjs",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 22"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.4.1",
    "jest": "29.7.0",
    "rollup": "4.63.1",
    "rollup-plugin-dts": "6.5.1",
    "typescript": "6.0.3"
  }
}
